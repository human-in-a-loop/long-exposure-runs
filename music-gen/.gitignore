# Audio bytes never committed; docs and manifests inside corpus/ are OK.
corpus/**/*.mp3
corpus/**/*.wav
corpus/**/*.flac
corpus/**/*.m4a
corpus/**/*.opus
corpus/**/*.ogg
corpus/**/*.webm
corpus/**/*.aac
data/
*.log

# M-INGEST-1: chunker outputs are large and byte-derivable from the manifest,
# so they are explicitly ignored even if `data/` is ever narrowed.
data/ingestion/clips/
data/ingestion/egress_status.jsonl

# never commit virtualenvs the run creates
*_venv/
.venv/
venv/

# model weights live on disk only (sha256 receipts are tracked instead)
workspace/models/
